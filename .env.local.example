# Supabase
# supabase.com → プロジェクト設定 → API から取得
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role（Edge Functions・サーバーサイドのみ使用。クライアントには絶対渡さない）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe（stripe.com → ダッシュボード → 開発者 → APIキー）
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook（stripe listen --forward-to localhost:3000/api/stripe/webhook で取得）
STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI（サーバーサイドのみ。NEXT_PUBLIC_ は付けないこと）
OPENAI_API_KEY=
# AI相談の1ユーザー1日の上限回数（日本時間 0:00 で切り替え。未設定なら 10）
# AI_DAILY_LIMIT=10

# Google Maps: Places API (New) / Routes API（サーバーサイドのみ。NEXT_PUBLIC_ は付けないこと）
GOOGLE_MAPS_API_KEY=
# 場所検索の1日の上限回数。ユーザーごと（未設定なら 100）と全体（未設定なら 1000）
# PLACES_DAILY_LIMIT=100
# PLACES_GLOBAL_DAILY_LIMIT=1000
