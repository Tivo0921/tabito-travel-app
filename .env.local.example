# Supabase
# supabase.com → プロジェクト設定 → API から取得
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role（Edge Functions・サーバーサイドのみ使用。クライアントには絶対渡さない）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe（stripe.com → ダッシュボード → 開発者 → APIキー）
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook（stripe listen --forward-to localhost:3000/api/stripe/webhook で取得）
STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI（サーバーサイドのみ。NEXT_PUBLIC_ は付けないこと）
OPENAI_API_KEY=
# AI相談の1ユーザー1日の上限回数（日本時間 0:00 で切り替え。未設定なら 10）
# AI_DAILY_LIMIT=10

# Google Maps: Places API (New) / Routes API（サーバーサイドのみ。NEXT_PUBLIC_ は付けないこと）
GOOGLE_MAPS_API_KEY=
# 場所検索の1日の上限回数。ユーザーごと（未設定なら 100）と全体（未設定なら 1000）
# PLACES_DAILY_LIMIT=100
# PLACES_GLOBAL_DAILY_LIMIT=1000

# Google Maps: Maps JavaScript API（計画の地図モード #30。ブラウザに公開される）
# 上の GOOGLE_MAPS_API_KEY とは別のキーを作ること。Google Cloud で必ず次を設定する:
#   API 制限 = Maps JavaScript API のみ / HTTP リファラ制限 = tabito.site, stg.tabito.site, localhost
#   / 1日のクォータと予算アラート
# 未設定なら地図モードは「利用できません」と出し、タイムラインはそのまま使える
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
